    <script>
        function revealNote() {
            // 1. Hide the introduction section
            document.getElementById('intro-section').style.display = 'none';

            // 2. Show the special note section
            const note = document.getElementById('note-section');
            note.style.display = 'block';

            // 3. Change background for the reveal effect
            document.body.style.background = 'linear-gradient(to right, #FFECF4, #FFE3E3)'; 
            document.body.style.color = '#555'; 
            
            // Optional: Hide balloons after click for cleaner note display
            document.querySelectorAll('.balloon').forEach(b => b.style.display = 'none');
        }

        function popBalloon(balloonElement) {
            // Apply a quick scale-down and fade out effect
            balloonElement.style.transform = 'scale(0.1)';
            balloonElement.style.opacity = '0';
            
            // Remove the balloon from the DOM after the animation (0.1s)
            setTimeout(() => {
                balloonElement.remove();
            }, 100); 
        }
    </script>

</body>
